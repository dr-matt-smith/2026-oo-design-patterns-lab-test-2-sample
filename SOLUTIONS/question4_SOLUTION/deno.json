{
  "tasks": {
    "test": "deno run --allow-read --allow-write --allow-run --allow-env tools/test_report.ts",
    "check": "deno check src/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "noImplicitOverride": true
  },
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "include": ["explicit-function-return-type"]
    }
  },
  "exclude": ["docs/", "test_output/", "test_coverage_output/"]
}
