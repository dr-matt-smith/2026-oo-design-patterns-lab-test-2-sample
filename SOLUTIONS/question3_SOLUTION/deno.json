{
  "tasks": {
    "run": "deno run src/main.ts",
    "test": "deno run --allow-read --allow-write --allow-run --allow-env tools/test_report.ts",
    "coverage": "deno run --allow-read --allow-write --allow-run --allow-env tools/coverage_report.ts",
    "check": "deno check src/",
    "lint": "deno lint src/",
    "fmtcheck": "deno fmt --check src/",
    "fixsrc": "deno fmt src/",
    "doclint": "deno doc --lint src/*.ts",
    "doc": "deno doc --html --name=Question3 --output=docs src/Car.ts src/Intelligence.ts src/ElectricHybrid.ts src/SelfDrivingType.ts && deno run --allow-read=docs --allow-write=docs tools/doc_links.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "noImplicitOverride": true
  },
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "include": ["explicit-function-return-type"]
    }
  },
  "exclude": ["docs/", "test_output/", "test_coverage_output/"]
}
